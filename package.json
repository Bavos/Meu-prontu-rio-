  "dependencies": {
    "@remotion/cli": "latest",
    "@remotion/renderer": "latest",
    "framer-motion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "remotion": "latest"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}
