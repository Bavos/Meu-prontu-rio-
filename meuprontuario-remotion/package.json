{
  "name": "meuprontuario-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Vídeo comercial vertical silencioso de 30 segundos para o produto Meu Prontuário.",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render src/index.ts MeuProntuarioComercial out/MeuProntuario_Comercial_30s_Silent.mp4",
    "render:thumb": "remotion still src/index.ts MeuProntuarioComercial out/MeuProntuario_Thumbnail.png --frame=870",
    "zip": "zip -r out/MeuProntuario_Remotion.zip . -x \"node_modules/*\" \"out/*\" \".git/*\"",
    "artifact": "npm run render && npm run render:thumb && npm run zip"
  },
  "keywords": [
    "remotion",
    "react",
    "typescript",
    "healthtech",
    "vertical-video",
    "silent-video"
  ],
  "author": "Meu Prontuário",
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/poppins": "^5.2.7",
    "@remotion/cli": "^4.0.457",
    "@remotion/renderer": "^4.0.457",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.457"
  },
  "devDependencies": {
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.7.3"
  }
}
