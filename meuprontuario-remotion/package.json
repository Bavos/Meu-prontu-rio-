{
  "name": "meuprontuario-remotion",
  "version": "1.0.0",
  "description": "Vídeo comercial vertical silencioso do Meu Prontuário criado com Remotion, React e TypeScript.",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render src/index.ts MeuProntuarioComercial out/MeuProntuario_Comercial_30s_Silent.mp4",
    "render:thumb": "remotion still src/index.ts MeuProntuarioComercial out/MeuProntuario_Thumbnail.png --frame=870",
    "artifact": "mkdir -p out && npm run render && npm run render:thumb"
  },
  "dependencies": {
    "@remotion/cli": "latest",
    "@remotion/renderer": "latest",
    "remotion": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
