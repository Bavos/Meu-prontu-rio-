{
  "name": "meu-prontuario-commercial-video",
  "version": "1.0.0",
  "private": true,
  "description": "Vídeo comercial vertical silencioso de 30 segundos para Meu Prontuário, criado com React + Remotion.",
  "scripts": {
    "dev": "remotion studio src/index.tsx",
    "build": "remotion bundle src/index.tsx",
    "render": "npm run render:remotion && npm run strip:audio",
    "render:remotion": "remotion render src/index.tsx MeuProntuarioCommercial ../.MeuProntuario_Comercial_30s_Silent.with-audio.mp4 --codec=h264 --pixel-format=yuv420p --concurrency=3 --muted",
    "strip:audio": "ffmpeg -y -i ../.MeuProntuario_Comercial_30s_Silent.with-audio.mp4 -c:v copy -an ../MeuProntuario_Comercial_30s_Silent.mp4 && rm -f ../.MeuProntuario_Comercial_30s_Silent.with-audio.mp4",
    "thumbnail": "remotion still src/index.tsx MeuProntuarioCommercial ../MeuProntuario_Thumbnail.png --frame=795",
    "validate:silent": "node scripts/validate-silent.mjs"
  },
  "keywords": [
    "remotion",
    "healthtech",
    "vertical-video",
    "silent-commercial"
  ],
  "author": "Meu Prontuário",
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "@remotion/cli": "^4.0.457",
    "@remotion/player": "^4.0.457",
    "@remotion/renderer": "^4.0.457",
    "framer-motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.457"
  },
  "devDependencies": {
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
